# cp .env.example .env 로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 값은 따옴표 없이 한 줄로 쓴다.

# Grafana 관리자(admin) 비밀번호
GRAFANA_ADMIN_PASSWORD=
# InfluxDB 조직 이름 (A에게 받는다. 비밀값 아님)
INFLUX_ORG=
# 버킷 trace-pilot 읽기 전용 토큰 (A에게 받는다. 채팅·커밋 금지)
INFLUX_READ_TOKEN=

# 바꿀 때만 채운다
# INFLUX_URL=http://influx.java21.net
# INFLUX_BUCKET=trace-pilot
# GRAFANA_PORT=3000
